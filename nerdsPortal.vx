NUMBER_RE = re.compile(r"^\+153\d{6}$")


def _clean_number(text):
    raw = re.sub(r"[\s\-()]+", "", str(text or ""))
    if re.fullmatch(r"\d{6}", raw):
        return "+153" + raw
    if raw.startswith("153") and re.fullmatch(r"153\d{6}", raw):
        return "+" + raw
    return raw


def _now():
    return _dt.datetime.now().replace(microsecond=0).isoformat()


def _ensure_user_dir():
    os.makedirs(USER_DIR, exist_ok=True)


def _load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def _save_json(path, data):
    _ensure_user_dir()
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def _new_nerds_number():
    return "+153" + "".join(secrets.choice("0123456789") for _ in range(6))


def _new_code(prefix="NRD"):
    a = "".join(secrets.choice("ABCDEFGHJKLMNPQRSTUVWXYZ23456789") for _ in range(4))
    b = "".join(secrets.choice("ABCDEFGHJKLMNPQRSTUVWXYZ23456789") for _ in range(4))
    return f"{prefix}-{a}-{b}"


def _new_device_id(display_name):
    base = "".join(ch for ch in display_name.upper() if ch.isalnum())[:6] or "NERD"
    return f"{base}-{secrets.token_hex(3).upper()}"


def _keypair_stub():
    private = secrets.token_hex(32)
    public = hashlib.sha256(private.encode("utf-8")).hexdigest()
    return private, public


def _short(text, length=12):
    if not text:
        return ""
    return text[:length]


def _normalize_url(url):
    url = (url or "").strip().rstrip("/")
    if not url:
        return ""
    if not url.startswith(("http://", "https://")):
        url = "http://" + url
    return url.rstrip("/")


def _local_ip():
    try:
        hostname = socket.gethostname()
        for info in socket.getaddrinfo(hostname, None, socket.AF_INET):
            ip = info[4][0]
            if ip and not ip.startswith("127."):
                return ip
    except Exception:
        pass
    return "127.0.0.1"


def _find_free_port(start=DEFAULT_SELF_PORT):
    for port in range(start, start + 100):
        sock = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.bind(("0.0.0.0", port))
            return port
        except Exception:
            pass
        finally:
            try:
                if sock:
                    sock.close()
            except Exception:
                pass
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("0.0.0.0", 0))
        return int(sock.getsockname()[1])
    finally:
        sock.close()


def _preferred_port_for_number(number):
    number = _clean_number(number)
    if NUMBER_RE.match(number):
        return 10000 + int(number[-4:])
    return DEFAULT_SELF_PORT


def _local_ipv4s():
    ips = set()
    try:
        for ip in socket.gethostbyname_ex(socket.gethostname())[2]:
            ips.add(ip)
    except Exception:
        pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ips.add(info[4][0])
    except Exception:
        pass
    return sorted(ip for ip in ips if ip and not ip.startswith("127.") and ip.count(".") == 3)


def _ws_recv_exact(sock, size):
    data = b""
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if not chunk:
            raise ConnectionError("websocket closed")
        data += chunk
    return data


def _ws_send_frame(sock, payload, opcode=1, masked=True):
    if isinstance(payload, str):
        payload = payload.encode("utf-8")
    first = 0x80 | opcode
    mask_bit = 0x80 if masked else 0
    length = len(payload)
    if length < 126:
        header = bytes([first, mask_bit | length])
    elif length <= 0xFFFF:
        header = bytes([first, mask_bit | 126]) + struct.pack("!H", length)
    else:
        header = bytes([first, mask_bit | 127]) + struct.pack("!Q", length)
    if not masked:
        sock.sendall(header + payload)
        return
    key = os.urandom(4)
    masked_payload = bytes(b ^ key[i % 4] for i, b in enumerate(payload))
    sock.sendall(header + key + masked_payload)


def _ws_recv_frame(sock):
    first, second = _ws_recv_exact(sock, 2)
    opcode = first & 0x0F
    masked = bool(second & 0x80)
    length = second & 0x7F
    if length == 126:
        length = struct.unpack("!H", _ws_recv_exact(sock, 2))[0]
    elif length == 127:
        length = struct.unpack("!Q", _ws_recv_exact(sock, 8))[0]
    key = _ws_recv_exact(sock, 4) if masked else b""
    payload = _ws_recv_exact(sock, length) if length else b""
    if masked:
        payload = bytes(b ^ key[i % 4] for i, b in enumerate(payload))
    return opcode, payload


class NerdsGateClient:
    def __init__(self, portal, url, events):
        self.portal = portal
        self.url = url
        self.events = events
        self.sock = None
        self.thread = None
        self.lock = threading.Lock()
        self.running = False

    def start(self):
        if self.running:
            return
        self.running = True
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False
        sock = self.sock
        self.sock = None
        if sock is not None:
            try:
                sock.close()
            except Exception:
                pass

    def send(self, item):
        raw = json.dumps(item, ensure_ascii=False)
        with self.lock:
            if self.sock is None:
                raise ConnectionError("Nerds Gate is not connected")
            _ws_send_frame(self.sock, raw, masked=True)

    def _connect_socket(self):
        parsed = urlparse(self.url)
        scheme = parsed.scheme.lower()
        if scheme not in ("ws", "wss"):
            raise ValueError("Gate URL must start with ws:// or wss://")
        host = parsed.hostname
        if not host:
            raise ValueError("Gate URL missing host")
        port = parsed.port or (443 if scheme == "wss" else 80)
        path = parsed.path or "/ws"
        if parsed.query:
            path += "?" + parsed.query
        raw = socket.create_connection((host, port), timeout=8)
        if scheme == "wss":
            raw = ssl.create_default_context().wrap_socket(raw, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        request = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        )
        raw.sendall(request.encode("ascii"))
        response = b""
        while b"\r\n\r\n" not in response:
            chunk = raw.recv(4096)
            if not chunk:
                break
            response += chunk
            if len(response) > 65536:
                break
        if b" 101 " not in response.split(b"\r\n", 1)[0]:
            raise ConnectionError(response.decode("utf-8", "replace").splitlines()[0] if response else "Gate handshake failed")
        raw.settimeout(1.0)
        return raw

    def _register(self):
        ident = self.portal.identity or {}
        self.send({
            "protocol": "nerds.gate.v1",
            "type": "register",
            "number": _clean_number(ident.get("portal_number", "")),
            "name": ident.get("display_name", ""),
            "device_id": ident.get("device_id", ""),
            "client_version": self.portal.VERSION,
            "sent_at": _now(),
        })

    def _loop(self):
        while self.running:
            try:
                self.events.put({"type": "gate_status", "text": "Connecting to Nerds Gate..."})
                self.sock = self._connect_socket()
                self._register()
                self.events.put({"type": "gate_status", "text": "Internet Mode online via Nerds Gate"})
                while self.running and self.sock is not None:
                    try:
                        opcode, payload = _ws_recv_frame(self.sock)
                    except socket.timeout:
                        continue
                    if opcode == 8:
                        raise ConnectionError("Gate closed the connection")
                    if opcode == 9:
                        with self.lock:
                            if self.sock is not None:
                                _ws_send_frame(self.sock, payload, opcode=10, masked=True)
                        continue
                    if opcode != 1:
                        continue
                    item = json.loads(payload.decode("utf-8", "replace"))
                    self.events.put(item)
            except Exception as exc:
                if self.running:
                    self.events.put({"type": "gate_status", "text": f"Gate offline: {exc}"})
                    time.sleep(3)
            finally:
                sock = self.sock
                self.sock = None
                if sock is not None:
                    try:
                        sock.close()
                    except Exception:
                        pass


class NerdsPortal(LuciWindow):
    TITLE = "Nerds Portal v0.10 Contacts"
    ICON = "NP"
    SIZE = (980, 700)
    VERSION = "0.10"
    AUTHOR = "Vincent Ilagan"
    ABOUT = "Local-first portal identity, direct chat, rooms, feed, and file-drop prototype."

    def __init__(self, desktop=None):
        self.identity = _load_json(IDENTITY_FILE, {})
        self.rooms = _load_json(ROOMS_FILE, [])
        self.feed = _load_json(FEED_FILE, [])
        self.drops = _load_json(DROP_FILE, [])
        self.messages = _load_json(MESSAGES_FILE, [])
        self.contacts = _load_json(CONTACTS_FILE, {})
        self.selfhost = _load_json(SELFHOST_FILE, {"port": DEFAULT_SELF_PORT})
        self.gate = _load_json(GATE_FILE, {"mode": "Hybrid Auto Mode", "url": "wss://nerdsgate.onrender.com/ws"})
        self.httpd = None
        self.http_thread = None
        self.gate_client = None
        self.gate_events = queue.Queue()
        self.gate_status = "Nerds Gate offline"
        self.online_numbers = set()
        self.last_online_check = 0
        self.active_chat_number = ""
        self.live_room = None
        self.snapshot_timer = None
        self.live_snapshot = {}
        self.discovery_sock = None
        self.discovery_thread = None
        self.discovery_stop = False
        self.discovery_status = "LAN discovery offline"
        self.message_timer = None
        self.last_message_count = len(self.messages) if isinstance(self.messages, list) else 0
        super().__init__(desktop)
        self.message_timer = QTimer(self)
        self.message_timer.timeout.connect(self._heartbeat)
        self.message_timer.start(1000)

